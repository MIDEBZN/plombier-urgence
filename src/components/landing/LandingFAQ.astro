---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQItem[];
  title?: string;
}

const { faqs, title = "Questions Fréquentes" } = Astro.props;
---

<section class="lp-faq-section" id="faq">
  <div class="container">
    <div class="lp-section-header text-center">
      <span class="lp-badge">FAQ & Conseils</span>
      <h2 class="lp-section-title">{title}</h2>
      <p class="lp-section-subtitle">
        Des réponses claires à vos questions les plus fréquentes sur nos dépannages d'urgence, nos tarifs et nos modalités.
      </p>
    </div>

    <div class="lp-faq-list">
      {faqs.map((faq, index) => (
        <details class="lp-faq-item card" open={index === 0}>
          <summary class="lp-faq-question">
            <span>{faq.question}</span>
            <span class="lp-faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="lp-faq-answer">
            <p set:html={faq.answer} />
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .lp-faq-section {
    padding: var(--space-3xl) 0;
    background: #ffffff;
  }
  .lp-section-header {
    max-width: 680px;
    margin: 0 auto var(--space-2xl);
  }
  .lp-badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    background: rgba(59, 54, 228, 0.08);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }
  .lp-section-title {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 900;
    color: var(--color-text);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }
  .lp-section-subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .lp-faq-list {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .lp-faq-item {
    background: #fafbfc;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .lp-faq-item[open] {
    background: #ffffff;
    border-color: #cbd5e1;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
  }
  .lp-faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.15rem 1.35rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .lp-faq-question::-webkit-details-marker {
    display: none;
  }
  .lp-faq-icon {
    font-size: 1.4rem;
    line-height: 1;
    color: var(--color-accent);
    font-weight: 700;
    transition: transform 0.2s ease;
  }
  .lp-faq-item[open] .lp-faq-icon {
    transform: rotate(45deg);
  }
  .lp-faq-answer {
    padding: 0 1.35rem 1.25rem;
    font-size: 0.925rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    border-top: 1px solid rgba(0, 0, 0, 0.04);
    margin-top: 0.25rem;
    padding-top: 0.85rem;
  }
  .lp-faq-answer p {
    margin: 0;
  }
  .lp-faq-answer a {
    color: var(--color-accent);
    text-decoration: underline;
    font-weight: 600;
  }
  @media (max-width: 768px) {
    .lp-faq-section {
      padding: 2.25rem 0;
    }
    .lp-section-header {
      margin-bottom: 1.5rem;
    }
    .lp-section-title {
      font-size: 1.45rem;
    }
    .lp-section-subtitle {
      font-size: 0.9rem;
    }
    .lp-faq-question {
      padding: 0.95rem 1.1rem;
      font-size: 0.95rem;
    }
    .lp-faq-answer {
      padding: 0 1.1rem 1rem;
      font-size: 0.875rem;
    }
  }
</style>
