---
const navLinks = [
  { label: 'Accueil', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'Zones', href: '/zones/' },
  { label: 'Tarifs', href: '/tarifs/' },
  { label: 'Guides', href: '/blog/' },
  { label: 'Cas Pratiques', href: '/cas-etudes/' },
  { label: 'À Propos', href: '/a-propos/' },
  { label: 'Avis', href: '/avis-clients/' },
  { label: 'Contact', href: '/contact/' },
];

const currentPath = Astro.url.pathname;
---

<!-- Top bar: trust signals -->
<div class="topbar">
  <div class="container topbar__inner">
    <div class="topbar__left">
      <span class="topbar__item">📍 Toute la Belgique</span>
      <span class="topbar__sep">|</span>
      <span class="topbar__item">📞 <a href="tel:0465685158" style="color:white;">0465 68 51 58</a></span>
      <span class="topbar__sep">|</span>
      <span class="topbar__item">🕐 24h/24 — 7j/7</span>
    </div>
  </div>
</div>

<header class="header" id="main-header">
  <div class="container header__inner">
    <a href="/" class="header__logo">
      <img src="/logo.png" alt="Plombier Urgence Logo" style="height: 56px; width: auto; object-fit: contain;" />
    </a>

    <nav class="header__nav" id="main-nav">
      {navLinks.map(link => (
        <a
          href={link.href}
          class={`header__link ${currentPath === link.href ? 'header__link--active' : ''}`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header__actions">
      <!-- Phone/Quote Button like screenshot -->
      <a href="/contact/" class="btn btn-primary header__btn-quote">
        Devis Gratuit
      </a>
    </div>

    <button class="header__burger" id="burger-btn" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  /* Top bar */
  .topbar {
    background: var(--color-accent);
    color: #fff;
    font-size: 0.8rem;
    padding: 0.6rem 0;
  }

  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .topbar__left {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .topbar__sep {
    color: rgba(255, 255, 255, 0.4);
  }

  .topbar__right {
    display: flex;
    align-items: center;
  }

  .topbar__social {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .topbar__social a {
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }
  .topbar__social a:hover {
    color: rgba(255, 255, 255, 0.8);
  }

  /* Header */
  .header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: #ffffff;
    border-bottom: 1px solid var(--color-border);
    transition: all var(--transition-base);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    position: relative;
    z-index: 100;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.2rem;
    color: var(--color-text);
    font-weight: 500;
    letter-spacing: -0.02em;
    position: relative;
    z-index: 100;
  }

  .header__logo:hover { color: var(--color-text); }

  .header__logo strong {
    color: var(--color-accent);
    font-weight: 800;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .header__link {
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 600;
    position: relative;
    padding: 0.25rem 0;
    transition: color var(--transition-fast);
  }

  .header__link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-accent);
    border-radius: 1px;
    transition: width var(--transition-base);
  }

  .header__link:hover,
  .header__link--active {
    color: var(--color-text);
  }

  .header__link:hover::after,
  .header__link--active::after {
    width: 100%;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    position: relative;
    z-index: 100;
  }

  .header__btn-quote {
    border-radius: 999px;
    padding: 0.75rem 1.5rem;
  }

  .header__burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 4px;
    position: relative;
    z-index: 100;
  }

  .header__burger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: all var(--transition-base);
  }

  @media (max-width: 1100px) {
    .btn-devis { display: none; }
  }

  @media (max-width: 768px) {
    .topbar__left {
      flex-wrap: wrap;
      justify-content: center;
      text-align: center;
      width: 100%;
    }
    .topbar__sep { display: none; }

    .header__nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      height: 100vh;
      flex-direction: column;
      background: var(--color-bg);
      padding: calc(72px + var(--space-2xl)) var(--space-2xl) var(--space-2xl);
      gap: var(--space-lg);
      transform: translateX(100%);
      transition: transform var(--transition-base);
      z-index: 90;
      overflow-y: auto;
    }

    .header__nav.open {
      transform: translateX(0);
    }

    .header__link {
      font-size: var(--font-size-lg);
    }

    .header__wa span,
    .btn-whatsapp { font-size: 0; gap: 0; padding: 0.5rem; }
    .btn-whatsapp svg { width: 22px; height: 22px; }

    .header__cta { font-size: 0.85rem; padding: 0.5rem 0.9rem; }

    .header__burger {
      display: flex;
    }

    .header__burger.active span:nth-child(1) {
      transform: rotate(45deg) translateY(7px);
    }
    .header__burger.active span:nth-child(2) {
      opacity: 0;
    }
    .header__burger.active span:nth-child(3) {
      transform: rotate(-45deg) translateY(-7px);
    }
  }

  /* Sticky Header Styles */
  .topbar--hidden {
    display: none;
  }

  .header--sticky {
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }
</style>

<script>
  const burger = document.getElementById('burger-btn');
  const nav = document.getElementById('main-nav');

  burger?.addEventListener('click', () => {
    burger.classList.toggle('active');
    nav?.classList.toggle('open');
  });

  nav?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      burger?.classList.remove('active');
      nav?.classList.remove('open');
    });
  });

  // Sticky topbar hide on scroll with performance optimization
  const topbar = document.querySelector('.topbar') as HTMLElement;
  const header = document.querySelector('.header') as HTMLElement;
  let ticking = false;

  if (topbar && header) {
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const y = window.scrollY;
          if (y > 60) {
            topbar.classList.add('topbar--hidden');
            header.classList.add('header--sticky');
          } else {
            topbar.classList.remove('topbar--hidden');
            header.classList.remove('header--sticky');
          }
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  }
</script>
</script>
