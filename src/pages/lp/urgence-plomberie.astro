---
import LandingLayout from '../../layouts/LandingLayout.astro';
import LandingForm from '../../components/landing/LandingForm.astro';
import LandingProcess from '../../components/landing/LandingProcess.astro';
import LandingTrust from '../../components/landing/LandingTrust.astro';
import LandingFAQ from '../../components/landing/LandingFAQ.astro';
import { LANDING_CONFIG } from '../../data/landing-config';

const title = "Plombier d'Urgence Bruxelles 24h/24 & 7j/7 | Dépannage Immédiat";
const description = "Besoin d'un plombier en urgence à Bruxelles et périphérie ? Rupture de canalisation, fuite d'eau, dégât des eaux. Appel direct au 0465 68 51 58. Devis avant travaux.";
const canonicalPath = "/lp/urgence-plomberie/";

const faqs = [
  {
    question: "Que dois-je faire immédiatement en attendant le plombier ?",
    answer: "<strong>1. Coupez l'eau :</strong> Fermez immédiatement la vanne d'arrêt générale située près de votre compteur d'eau (généralement en cave, garage ou sous l'évier).<br><strong>2. Sécurisez l'électricité :</strong> Si l'eau stagne près de prises, d'interrupteurs ou du tableau électrique, coupez le disjoncteur correspondant.<br><strong>3. Épongez et aérez :</strong> Limitez la progression de l'humidité et prenez des photos pour votre assurance habitation.<br><strong>4. Restez joignable :</strong> Notre technicien vous appelle dès son départ pour confirmer son créneau d'arrivée."
  },
  {
    question: "Combien coûte une intervention d'urgence en plomberie ?",
    answer: `Le coût dépend de la nature exacte de la panne (raccord à remplacer, tuyau percé, vanne bloquée). Lors de votre appel au <a href="${LANDING_CONFIG.phoneTel}">${LANDING_CONFIG.phoneDisplay}</a>, notre dispatcheur vous communique une estimation de base selon votre description. Sur place, un devis écrit et ferme vous est présenté avant tout commencement des travaux. Pour les interventions de nuit (20h - 7h), les samedis, dimanches et jours fériés, un supplément fixe de 50€ s'applique.`
  },
  {
    question: "L'intervention en urgence est-elle remboursée par l'assurance habitation ?",
    answer: "Oui, la majorité des contrats d'assurance habitation (multirisques incendie/dégâts des eaux) en Belgique couvrent la recherche de fuite et les conséquences du dégât des eaux. À la fin de notre prestation, le technicien vous remet une facture détaillée et acquittée avec description précise du sinistre, prête à être transmise à votre courtier ou compagnie d'assurance."
  },
  {
    question: "Quels sont les moyens de paiement acceptés sur place ?",
    answer: "Pour faciliter votre règlement en situation d'urgence, nos techniciens acceptent le paiement par carte bancaire (terminal Bancontact portable), application mobile (Payconiq / code QR), virement bancaire instantané ou paiement en espèces avec reçu immédiat."
  },
  {
    question: "Quelles communes couvrez-vous à Bruxelles et en périphérie ?",
    answer: "Nos équipes couvrent l'intégralité des 19 communes de Bruxelles-Capitale (Bruxelles-Ville, Schaerbeek, Ixelles, Uccle, Anderlecht, Etterbeek, Saint-Gilles, Molenbeek, Forest, Woluwe, etc.) ainsi que les communes limitrophes du Brabant Wallon et Flamand (Waterloo, Braine-l'Alleud, Wavre, Zaventem, Vilvorde, Kraainem, etc.)."
  }
];
---

<LandingLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  adGroupLabel="Urgence-Plomberie"
>
  <!-- Hero Section -->
  <section class="lp-hero">
    <div class="container lp-hero__grid">
      <div class="lp-hero__content">
        <div class="lp-hero__pill">
          <span class="lp-pulse-dot"></span>
          <span>Permanence d'Urgence Active 24h/24 — 7j/7</span>
        </div>

        <h1 class="lp-hero__title">
          Plombier d'Urgence à Bruxelles : <span class="text-accent">Dépannage Rapide & Garanti</span>
        </h1>

        <p class="lp-hero__lead">
          Rupture de canalisation, fuite d'eau incontrôlable, vanne cassée ou inondation imminente ? Nos plombiers dépanneurs interviennent à Bruxelles et ses alentours.
        </p>

        <!-- Emergency Alert Box -->
        <div class="lp-emergency-box">
          <div class="lp-emergency-box__icon">🚨</div>
          <div class="lp-emergency-box__text">
            <strong>Conseil d'urgence immédiat :</strong> Fermez dès maintenant la vanne générale d'arrivée d'eau (près du compteur) pour stopper les dégâts des eaux.
          </div>
        </div>

        <!-- Primary Call Action -->
        <div class="lp-hero__actions">
          <a
            href={LANDING_CONFIG.phoneTel}
            class="btn btn-primary lp-btn-call"
            data-cta="hero-primary-call"
            data-adgroup="Urgence-Plomberie"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1.003 1.003 0 011.01-.24c1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.1.31.03.66-.25 1.02l-2.2 2.2z"/>
            </svg>
            <div class="lp-btn-call__text">
              <span class="lp-btn-call__small">Appel d'Urgence Prioritaire</span>
              <span class="lp-btn-call__number">{LANDING_CONFIG.phoneDisplay}</span>
            </div>
          </a>

          <a
            href={LANDING_CONFIG.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn lp-btn-wa"
            data-cta="hero-wa"
            data-adgroup="Urgence-Plomberie"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>Photo par WhatsApp</span>
          </a>
        </div>

        <div class="lp-hero__guarantee-pills">
          <span class="lp-pill">✓ Tarif annoncé avant départ</span>
          <span class="lp-pill">✓ Devis validé sur place</span>
          <span class="lp-pill">✓ Facture pour assurance</span>
        </div>
      </div>

      <!-- Hero Callback Form -->
      <div class="lp-hero__form-wrapper">
        <LandingForm serviceName="Urgence Plomberie" formId="hero-urgence-form" />
      </div>
    </div>
  </section>

  <!-- Service Scope: What is Included / Excluded -->
  <section class="lp-scope-section">
    <div class="container">
      <div class="lp-section-header text-center">
        <span class="lp-badge">Périmètre d'Intervention</span>
        <h2 class="lp-section-title">Ce que nous prenons en charge d'urgence</h2>
        <p class="lp-section-subtitle">
          Une transparence totale sur nos capacités de dépannage immédiat à Bruxelles.
        </p>
      </div>

      <div class="lp-scope-grid">
        <div class="lp-scope-col lp-scope-col--included card">
          <h3 class="lp-scope-title">
            <span class="lp-icon-check">✓</span> Pannes traitées en urgence immédiate
          </h3>
          <ul class="lp-scope-list">
            <li><strong>Rupture de tuyauterie :</strong> Colmatage et remplacement de portions de tuyaux percés (cuivre, multicouche, plomb, PER).</li>
            <li><strong>Fuite sur colonne montante ou vanne :</strong> Arrêt de la fuite, remplacement de vannes de sectionnement et robinets d'arrêt défaillants.</li>
            <li><strong>Raccords sous évier & sanitaires :</strong> Remplacement express de flexibles arrachés, siphons fissurés et joints sous pression.</li>
            <li><strong>Mise en sécurité dégât des eaux :</strong> Coupure ciblée pour éviter d'inonder les voisins ou les étages inférieurs.</li>
            <li><strong>Rapport d'intervention :</strong> Établissement de la facture officielle détaillée pour remboursement assurance.</li>
          </ul>
        </div>

        <div class="lp-scope-col lp-scope-col--excluded card">
          <h3 class="lp-scope-title">
            <span class="lp-icon-cross">✕</span> Ce qui relève de chantiers programmés
          </h3>
          <ul class="lp-scope-list">
            <li><strong>Rénovation complète :</strong> Remplacement complet de salle de bain ou carrelage (traité sur devis de jour après urgence).</li>
            <li><strong>Travaux structurels en copropriété :</strong> Réfection globale des colonnes d'évacuation nécessitant un vote d'assemblée générale.</li>
            <li><strong>Terrassement lourd de voirie :</strong> Réfection de collecteurs extérieurs en voirie publique (relevant des services communaux ou de Vivaqua).</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Transparent Pricing Section -->
  <section class="lp-pricing-section">
    <div class="container">
      <div class="lp-section-header text-center">
        <span class="lp-badge">Tarifs Clairs & Précis</span>
        <h2 class="lp-section-title">Comment s'établit le tarif de votre intervention ?</h2>
        <p class="lp-section-subtitle">
          Chaque situation est unique. Nous appliquons une politique de transparence stricte sans frais cachés.
        </p>
      </div>

      <div class="lp-pricing-grid">
        <div class="lp-pricing-card card">
          <h3 class="lp-pricing-card__title">1. Estimation téléphonique</h3>
          <p class="lp-pricing-card__text">
            Dès votre appel au <strong>0465 68 51 58</strong>, nous évaluons la panne et vous annonçons la base tarifaire avant que le technicien ne se mette en route.
          </p>
        </div>

        <div class="lp-pricing-card card">
          <h3 class="lp-pricing-card__title">2. Devis préalable sur place</h3>
          <p class="lp-pricing-card__text">
            Arrivé chez vous, le plombier inspecte l'origine de la panne et vous remet un devis écrit complet (déplacement, main d'œuvre et pièces).
          </p>
        </div>

        <div class="lp-pricing-card card">
          <h3 class="lp-pricing-card__title">3. Barème horaire & suppléments</h3>
          <p class="lp-pricing-card__text">
            Un supplément fixe de <strong>50€</strong> s'applique pour les interventions de nuit (20h - 7h), samedis, dimanches et jours fériés.
          </p>
        </div>

        <div class="lp-pricing-card card">
          <h3 class="lp-pricing-card__title">4. Taux de TVA légal en Belgique</h3>
          <p class="lp-pricing-card__text">
            TVA réduite à <strong>6%</strong> pour les habitations privées de plus de 10 ans, ou <strong>21%</strong> pour les immeubles récents et locaux professionnels.
          </p>
        </div>
      </div>

      <div class="lp-pricing-callout">
        <p><strong>Besoin d'un tarif immédiat pour votre situation ?</strong></p>
        <a href={LANDING_CONFIG.phoneTel} class="btn btn-primary" data-cta="pricing-call" data-adgroup="Urgence-Plomberie">
          📞 Demandez l'estimation par téléphone au {LANDING_CONFIG.phoneDisplay}
        </a>
      </div>
    </div>
  </section>

  <!-- Process Component -->
  <LandingProcess serviceName="votre urgence plomberie" />

  <!-- Trust Component -->
  <LandingTrust />

  <!-- FAQ Component -->
  <LandingFAQ faqs={faqs} title="Questions fréquentes sur l'urgence plomberie" />

  <!-- Final CTA Banner -->
  <section class="lp-final-cta">
    <div class="container text-center">
      <h2 class="lp-final-cta__title">Une fuite ou une inondation ne peut pas attendre</h2>
      <p class="lp-final-cta__lead">
        Nos techniciens sont équipés et disponibles à Bruxelles. Appelez maintenant pour une prise en charge immédiate.
      </p>
      <div class="lp-final-cta__buttons">
        <a
          href={LANDING_CONFIG.phoneTel}
          class="btn btn-primary lp-btn-call"
          data-cta="final-cta-phone"
          data-adgroup="Urgence-Plomberie"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1.003 1.003 0 011.01-.24c1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.1.31.03.66-.25 1.02l-2.2 2.2z"/>
          </svg>
          <div class="lp-btn-call__text">
            <span class="lp-btn-call__small">Ligne Directe 24/7</span>
            <span class="lp-btn-call__number">{LANDING_CONFIG.phoneDisplay}</span>
          </div>
        </a>

        <a
          href={LANDING_CONFIG.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn lp-btn-wa"
          data-cta="final-cta-wa"
          data-adgroup="Urgence-Plomberie"
        >
          <span>Envoyer une photo par WhatsApp</span>
        </a>
      </div>
    </div>
  </section>
</LandingLayout>

<style>
  /* Hero Styles */
  .lp-hero {
    padding: var(--space-3xl) 0 var(--space-2xl);
    background: linear-gradient(180deg, #f0f7ff 0%, #ffffff 100%);
    border-bottom: 1px solid var(--color-border);
  }
  .lp-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 992px) {
    .lp-hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3.5rem;
    }
  }
  .lp-hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    color: #1e293b;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    margin-bottom: 1rem;
  }
  .lp-pulse-dot {
    width: 8px;
    height: 8px;
    background: #ef4444;
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.25);
  }
  .lp-hero__title {
    font-size: clamp(2rem, 4vw, 2.85rem);
    font-weight: 900;
    line-height: 1.15;
    color: #0f172a;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  .lp-hero__lead {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  .lp-emergency-box {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-left: 4px solid #ef4444;
    border-radius: 8px;
    padding: 0.85rem 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: #991b1b;
    line-height: 1.45;
  }
  .lp-emergency-box__icon {
    font-size: 1.25rem;
    line-height: 1;
  }
  .lp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .lp-btn-call {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: #ffffff;
    padding: 0.75rem 1.5rem;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(239, 68, 68, 0.4);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .lp-btn-call:hover {
    background: #dc2626;
    color: #ffffff;
    transform: translateY(-2px);
  }
  .lp-btn-call__text {
    display: flex;
    flex-direction: column;
    text-align: left;
  }
  .lp-btn-call__small {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.9;
    font-weight: 700;
  }
  .lp-btn-call__number {
    font-size: 1.25rem;
    font-weight: 900;
    line-height: 1.1;
  }
  .lp-btn-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #ffffff;
    color: #15803d;
    border: 1px solid #bbf7d0;
    padding: 0.75rem 1.25rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.95rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }
  .lp-btn-wa:hover {
    background: #f0fdf4;
    color: #166534;
  }
  .lp-hero__guarantee-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #475569;
  }
  .lp-pill {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
  }

  /* Scope Styles */
  .lp-scope-section {
    padding: var(--space-3xl) 0;
    background: #ffffff;
  }
  .lp-scope-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .lp-scope-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .lp-scope-col {
    padding: 2rem;
    border-radius: var(--radius-lg);
  }
  .lp-scope-col--included {
    border-top: 4px solid #16a34a;
  }
  .lp-scope-col--excluded {
    border-top: 4px solid #94a3b8;
    background: #f8fafc;
  }
  .lp-scope-title {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .lp-icon-check {
    color: #16a34a;
    font-weight: 900;
  }
  .lp-icon-cross {
    color: #94a3b8;
    font-weight: 900;
  }
  .lp-scope-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 0.925rem;
    line-height: 1.55;
    color: #334155;
  }

  /* Pricing Section */
  .lp-pricing-section {
    padding: var(--space-3xl) 0;
    background: #f8fafc;
    border-top: 1px solid var(--color-border);
  }
  .lp-pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .lp-pricing-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .lp-pricing-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .lp-pricing-card {
    padding: 1.5rem;
    background: #ffffff;
    border-radius: var(--radius);
  }
  .lp-pricing-card__title {
    font-size: 1.1rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    color: var(--color-accent);
  }
  .lp-pricing-card__text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.55;
  }
  .lp-pricing-callout {
    margin-top: 2rem;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .lp-pricing-callout {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  /* Final CTA Banner */
  .lp-final-cta {
    padding: var(--space-4xl) 0;
    background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
    color: #ffffff;
  }
  .lp-final-cta__title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 900;
    line-height: 1.2;
    margin-bottom: 0.75rem;
    color: #ffffff;
  }
  .lp-final-cta__lead {
    font-size: 1.1rem;
    color: #cbd5e1;
    max-width: 650px;
    margin: 0 auto 2rem;
  }
  .lp-final-cta__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .lp-hero {
      padding: 1.25rem 0 1.75rem;
    }
    .lp-hero__grid {
      gap: 1.5rem;
    }
    .lp-hero__title {
      font-size: 1.65rem;
      line-height: 1.2;
      margin-bottom: 0.75rem;
    }
    .lp-hero__lead {
      font-size: 0.95rem;
      line-height: 1.5;
      margin-bottom: 1rem;
    }
    .lp-emergency-box {
      padding: 0.75rem 0.85rem;
      font-size: 0.825rem;
      margin-bottom: 1.15rem;
    }
    .lp-hero__actions {
      flex-direction: column;
      gap: 0.65rem;
      margin-bottom: 1.15rem;
    }
    .lp-btn-call {
      width: 100%;
      justify-content: center;
      min-height: 52px;
